{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "hookecho-web",
      "runtimeExecutable": "cargo",
      "runtimeArgs": [
        "run",
        "--release",
        "--bin",
        "hookecho",
        "--",
        "--serve",
        "8080",
        "--web-root",
        "web"
      ],
      "port": 8080
    },
    {
      "name": "hookecho-serve-built",
      "runtimeExecutable": "target/release/hookecho.exe",
      "runtimeArgs": [
        "--serve",
        "8080",
        "--web-root",
        "web"
      ],
      "port": 8080
    },
    {
      "name": "hookecho-serve-debug",
      "runtimeExecutable": "target/debug/hookecho.exe",
      "runtimeArgs": [
        "--serve",
        "8080",
        "--web-root",
        "web"
      ],
      "port": 8080
    }
  ]
}
